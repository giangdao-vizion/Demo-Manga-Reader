{
  "name": "image-links-extractor",
  "version": "1.0.0",
  "description": "Fetch a page and export all image URLs to JSON",
  "type": "module",
  "bin": {
    "image-links": "./cli.js",
    "batch-chapters": "./batch-chapters.js",
    "batch-asura-chapters": "./batch-asura-chapters.js",
    "batch-returnersmagic-chapters": "./batch-returnersmagic-chapters.js",
    "merge-chapter-sources": "./merge-chapter-sources.js",
    "batch-mgeko-chapters": "./batch-mgeko-chapters.js",
    "update-mgeko-json": "./update-mgeko-json.js",
    "crawl-kunmanga-series": "./crawl-kunmanga-series.js",
    "crawl-mgeko-series": "./crawl-mgeko-series.js",
    "crawl-onepunchmantruyen-series": "./crawl-onepunchmantruyen-series.js",
    "sync-catalog": "./sync-catalog.js",
    "sync-catalog-content": "./sync-catalog-content.js",
    "catalog-view": "./catalog/view-server.js",
    "sync-featured-updates": "./sync-featured-updates.js"
  },
  "scripts": {
    "start": "node cli.js",
    "batch": "node batch-chapters.js",
    "batch-asura": "node batch-asura-chapters.js",
    "batch-returnersmagic": "node batch-returnersmagic-chapters.js",
    "merge-chapters": "node merge-chapter-sources.js",
    "batch-mgeko": "node batch-mgeko-chapters.js",
    "update-mgeko": "node update-mgeko-json.js",
    "reader": "npx --yes serve . -l 3456",
    "catalog:sync": "node sync-catalog.js",
    "catalog:sync:qimanhwa": "node sync-catalog.js catalog/configs/qimanhwa-browse-martial.json",
    "playwright:install": "npx playwright install chromium",
    "catalog:content": "node sync-catalog-content.js",
    "catalog:content:qimanhwa": "node sync-catalog-content.js catalog/configs/qimanhwa-content.json",
    "catalog:content:all": "node sync-catalog-content.js catalog/configs/catalog-content-all-sources.json",
    "catalog:view": "PORT=8080 node catalog/view-server.js",
    "featured:sync": "node sync-featured-updates.js",
    "qimanhwa:images": "node get-qimanhwa-chapter-images.js",
    "qimanhwa:images:pw": "node get-qimanhwa-chapter-images.js --playwright",
    "mgeko:images": "node get-mgeko-chapter-images.js",
    "kunmanga:crawl": "node crawl-kunmanga-series.js",
    "mgeko:crawl": "node crawl-mgeko-series.js",
    "onepunchmantruyen:crawl": "node crawl-onepunchmantruyen-series.js",
    "chapters:normalize-titles": "node normalize-chapter-titles.js",
    "manhwa:export": "node export-sqlite-to-manhwa-json.js",
    "manhwa:catalog": "node export-sqlite-to-manhwa-json.js --catalog-rebuild"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "cheerio": "1.0.0-rc.12",
    "playwright": "^1.59.1"
  }
}
